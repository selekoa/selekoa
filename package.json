{
  "name": "selekoa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The biography of machine intelligence: research corpus, explanatory atlas and academic research starters.",
  "author": "futurelightcone",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm validate:data && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:migration": "tsx scripts/check-foundation-migration.ts",
    "review:seed": "tsx scripts/review-seed.ts",
    "review:assessments": "tsx scripts/review-assessments.ts",
    "review:earliest": "tsx scripts/review-earliest.ts",
    "docs:coverage": "tsx scripts/docs-coverage.ts",
    "question:gaps": "tsx scripts/question-gaps.ts",
    "research:corpus": "tsx scripts/research-corpus.ts",
    "research:provenance": "tsx scripts/research-followup.ts",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:privacy": "node --test scripts/test-privacy.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "notices": "tsx scripts/third-party-notices.ts",
    "release": "tsx scripts/release.ts"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@citation-js/plugin-ris": "^0.9.0",
    "@sigma/edge-curve": "^3.1.0",
    "graphology": "^0.26.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sigma": "^3.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.19.0"
}
